{
  "name": "@project-puff/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API server for Streamlets gacha system",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node --experimental-specifier-resolution=node dist/index.js",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "token:generate": "tsx src/lib/generate-token.ts",
    "token:viewer": "tsx src/lib/generate-token.ts viewer",
    "token:broadcaster": "tsx src/lib/generate-token.ts broadcaster",
    "token:moderator": "tsx src/lib/generate-token.ts moderator",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@project-puff/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.20.6",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
