# =============================================================================
# Database (Supabase PostgreSQL)
# =============================================================================
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres

# =============================================================================
# Twitch Extension
# =============================================================================
# Get from: https://dev.twitch.tv/console/extensions
TWITCH_EXTENSION_CLIENT_ID=your_extension_client_id_here
# Extension secret (Base64 encoded, get from Extension settings)
TWITCH_EXTENSION_SECRET=your_extension_secret_base64_here

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL (for extension to call)
# NOTE: Must be prefixed with VITE_ to be available in the extension frontend
VITE_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# CORS allowed origin (where extension runs)
CORS_ORIGIN=http://localhost:5173

# API server port
PORT=3000

# =============================================================================
# Development Mode
# =============================================================================
NODE_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=debug
